<?xml version="1.0" encoding="utf-8"?>
<!-- Main container for the add recipe screen -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:windowSoftInputMode="adjustResize">

    <!-- Top Bar with back button, title and save button -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back button to navigate to previous screen -->
        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@color/white" />

        <!-- Screen title -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Add Recipe"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Save recipe button -->
        <Button
            android:id="@+id/saveButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Recipe"
            android:textColor="@color/white"
            android:backgroundTint="@color/orange"
            android:paddingHorizontal="16dp" />
    </LinearLayout>

    <!-- ScrollView to make content scrollable when it exceeds screen height -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:scrollbars="none"
        android:fadeScrollbars="true"
        android:isScrollContainer="true"
        android:windowSoftInputMode="adjustResize"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Content container for all recipe form elements -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <!-- Recipe Details Card - contains basic recipe information -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1A1A1A"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Recipe name field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recipe"
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                    <EditText
                        android:id="@+id/recipeNameInput"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Recipe Name"
                        android:textColorHint="@color/gray"
                        android:textColor="@color/white"
                        android:background="@drawable/input_background"
                        android:textSize="18sp"
                        android:padding="12dp"
                        android:layout_marginBottom="16dp"
                        android:singleLine="true" />

                    <!-- Recipe description field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Description"
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                    <EditText
                        android:id="@+id/recipeDescriptionInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Recipe Description"
                        android:textColorHint="@color/gray"
                        android:textColor="@color/white"
                        android:background="@drawable/input_background"
                        android:gravity="top"
                        android:minLines="3"
                        android:padding="12dp"
                        android:layout_marginBottom="14dp" />

                    <!-- Cooking time and servings in a horizontal layout -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <!-- Cooking time input -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cooking Time"
                                android:textColor="@color/white"
                                android:textSize="14sp" />

                            <EditText
                                android:id="@+id/cookingTimeInput"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:hint="Minutes"
                                android:textColorHint="@color/gray"
                                android:textColor="@color/white"
                                android:background="@drawable/input_background"
                                android:inputType="number"
                                android:padding="12dp"
                                android:singleLine="true" />
                        </LinearLayout>

                        <!-- Number of servings input -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Servings"
                                android:textColor="@color/white"
                                android:textSize="14sp" />

                            <EditText
                                android:id="@+id/servingsInput"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:hint="No. of servings"
                                android:textColorHint="@color/gray"
                                android:textColor="@color/white"
                                android:background="@drawable/input_background"
                                android:inputType="number"
                                android:padding="12dp"
                                android:singleLine="true" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Recipe category dropdown -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Category"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/input_background">

                        <Spinner
                            android:id="@+id/categorySpinner"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:paddingStart="12dp"
                            android:paddingEnd="40dp"
                            android:spinnerMode="dropdown" />

                        <!-- Custom dropdown icon -->
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_dropdown"
                            app:tint="@color/gray" />
                    </RelativeLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Recipe Image Upload Card - allows user to add a recipe photo -->
            <androidx.cardview.widget.CardView
                android:id="@+id/imageUploadCard"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1A1A1A"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Recipe image display -->
                    <ImageView
                        android:id="@+id/recipeImageView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />

                    <!-- Button to remove uploaded image -->
                    <ImageButton
                        android:id="@+id/removeImageButton"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="8dp"
                        android:src="@drawable/ic_close"
                        android:background="@drawable/circle_background_dark"
                        android:visibility="gone"
                        app:tint="@color/white" />

                    <!-- Image upload prompt shown when no image is selected -->
                    <LinearLayout
                        android:id="@+id/uploadPromptLayout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp"
                        android:background="#1A1A1A">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_image"
                            app:tint="@color/gray" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Click to upload recipe image (optional)"
                            android:textColor="@color/gray" />
                    </LinearLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Ingredients Card - section for adding recipe ingredients -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1A1A1A"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header with ingredients title and total price -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ingredients"
                            android:textColor="@color/white"
                            android:textSize="18sp" />

                        <!-- Dynamic total price display -->
                        <TextView
                            android:id="@+id/totalPriceText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total: NRS 0.00"
                            android:textColor="@color/orange"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <!-- Container for dynamically added ingredient items -->
                    <LinearLayout
                        android:id="@+id/ingredientsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp" />

                    <!-- Button to add new ingredients -->
                    <Button
                        android:id="@+id/addIngredientButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add Ingredient"
                        android:textColor="@color/orange"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        app:strokeColor="@color/orange" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Instructions Card - section for adding recipe steps -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1A1A1A"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Instructions section title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Instructions"
                        android:textColor="@color/white"
                        android:textSize="18sp" />

                    <!-- Container for dynamically added instruction steps -->
                    <LinearLayout
                        android:id="@+id/instructionsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp" />

                    <!-- Button to add new instruction steps -->
                    <Button
                        android:id="@+id/addStepButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Add Step"
                        android:textColor="@color/orange"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        app:strokeColor="@color/orange" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>