<?xml version="1.0" encoding="utf-8"?>
<!-- CardView container for grocery ingredient item -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <!-- Main horizontal layout container -->
    <LinearLayout
        android:id="@+id/ingredientLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Left section: Ingredient information -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Ingredient name display -->
            <TextView
                android:id="@+id/ingredientName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Ingredient details (quantity, unit, etc.) -->
            <TextView
                android:id="@+id/ingredientDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/white"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Right section: Action checkboxes -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Checkbox to mark ingredient as purchased -->
            <CheckBox
                android:id="@+id/boughtCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bought"
                android:textColor="@color/white" />

            <!-- Checkbox to include ingredient in SMS grocery list -->
            <CheckBox
                android:id="@+id/smsCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SMS"
                android:textColor="@color/white" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>