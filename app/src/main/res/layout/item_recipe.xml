<?xml version="1.0" encoding="utf-8"?>
<!-- Recipe item card layout for the recipe list -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <!-- Main container for recipe item content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <!-- Recipe thumbnail image -->
        <ImageView
            android:id="@+id/recipeImage"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_recipe" />

        <!-- Container for recipe details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp">

            <!-- Recipe title -->
            <TextView
                android:id="@+id/recipeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Recipe short description -->
            <TextView
                android:id="@+id/recipeDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/gray"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />

            <!-- Recipe statistics container (time, servings, calories) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <!-- Cooking time indicator with icon -->
                <TextView
                    android:id="@+id/cookingTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/orange"
                    android:textSize="11sp"
                    android:drawableStart="@drawable/ic_time"
                    android:drawablePadding="2dp" />

                <!-- Number of servings indicator with icon -->
                <TextView
                    android:id="@+id/servings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/orange"
                    android:textSize="11sp"
                    android:layout_marginStart="8dp"
                    android:drawableStart="@drawable/ic_servings"
                    android:drawablePadding="2dp" />

                <!-- Calorie count indicator with icon -->
                <TextView
                    android:id="@+id/calories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/orange"
                    android:textSize="11sp"
                    android:layout_marginStart="8dp"
                    android:drawableStart="@drawable/ic_calories"
                    android:drawablePadding="2dp" />
            </LinearLayout>

            <!-- Button to add recipe to meal plan -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/addToPlanButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Add to Plan"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:backgroundTint="@color/orange"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="0dp"
                android:minHeight="32dp"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView> 