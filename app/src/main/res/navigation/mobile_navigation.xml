<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.meal_app.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_meals"
        android:name="com.example.meal_app.ui.meals.MealsFragment"
        android:label="Meals"
        tools:layout="@layout/fragment_meals" />

    <fragment
        android:id="@+id/navigation_grocery"
        android:name="com.example.meal_app.ui.grocery.GroceryFragment"
        android:label="Grocery List"
        tools:layout="@layout/fragment_grocery" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.example.meal_app.ui.profile.ProfileFragment"
        android:label="Profile" />

    <fragment
        android:id="@+id/navigation_add_recipe"
        android:name="com.example.meal_app.ui.recipe.AddRecipeFragment"
        android:label="Add Recipe"
        tools:layout="@layout/fragment_add_recipe" />

</navigation>