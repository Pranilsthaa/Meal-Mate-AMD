<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.meal_app.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_navigation_home_to_addRecipeFragment"
            app:destination="@id/navigation_add_recipe"
            app:enterAnim="@anim/fade_in_nav"
            app:exitAnim="@anim/fade_out_nav"
            app:popEnterAnim="@anim/fade_in_nav"
            app:popExitAnim="@anim/fade_out_nav" />
        <action
            android:id="@+id/action_navigation_home_to_recipeDetailsFragment"
            app:destination="@id/navigation_recipe_details"
            app:enterAnim="@anim/fade_in_nav"
            app:exitAnim="@anim/fade_out_nav"
            app:popEnterAnim="@anim/fade_in_nav"
            app:popExitAnim="@anim/fade_out_nav" />
    </fragment>

    <fragment
        android:id="@+id/navigation_meals"
        android:name="com.example.meal_app.ui.meals.MealsFragment"
        android:label="@string/title_meals"
        tools:layout="@layout/fragment_meals">
        <action
            android:id="@+id/action_navigation_meals_to_recipeDetailsFragment"
            app:destination="@id/navigation_recipe_details"
            app:enterAnim="@anim/fade_in_nav"
            app:exitAnim="@anim/fade_out_nav"
            app:popEnterAnim="@anim/fade_in_nav"
            app:popExitAnim="@anim/fade_out_nav" />
    </fragment>

    <fragment
        android:id="@+id/navigation_recipes"
        android:name="com.example.meal_app.ui.recipes.RecipesFragment"
        android:label="@string/title_recipes"
        tools:layout="@layout/fragment_recipes" />

    <fragment
        android:id="@+id/navigation_grocery"
        android:name="com.example.meal_app.ui.grocery.GroceryFragment"
        android:label="Grocery List"
        tools:layout="@layout/fragment_grocery" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.example.meal_app.ui.profile.ProfileFragment"
        android:label="@string/title_profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/navigation_add_recipe"
        android:name="com.example.meal_app.ui.recipe.AddRecipeFragment"
        android:label="Add Recipe"
        tools:layout="@layout/fragment_add_recipe" />

    <fragment
        android:id="@+id/navigation_recipe_details"
        android:name="com.example.meal_app.ui.recipe.RecipeDetailsFragment"
        android:label="Recipe Details"
        tools:layout="@layout/fragment_recipe_details">
        <argument
            android:name="recipeId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/editRecipeFragment"
        android:name="com.example.meal_app.ui.recipe.EditRecipeFragment"
        android:label="Edit Recipe"
        tools:layout="@layout/fragment_edit_recipe">
        <argument
            android:name="recipeId"
            app:argType="string" />
    </fragment>

    <action
        android:id="@+id/action_navigation_recipes_to_recipeDetailsFragment"
        app:destination="@id/navigation_recipe_details"
        app:enterAnim="@anim/fade_in_nav"
        app:exitAnim="@anim/fade_out_nav"
        app:popEnterAnim="@anim/fade_in_nav"
        app:popExitAnim="@anim/fade_out_nav" />

    <action
        android:id="@+id/action_navigation_recipes_to_addRecipeFragment"
        app:destination="@id/navigation_add_recipe"
        app:enterAnim="@anim/fade_in_nav"
        app:exitAnim="@anim/fade_out_nav"
        app:popEnterAnim="@anim/fade_in_nav"
        app:popExitAnim="@anim/fade_out_nav" />

    <action
        android:id="@+id/action_navigation_recipes_to_editRecipeFragment"
        app:destination="@id/editRecipeFragment"
        app:enterAnim="@anim/fade_in_nav"
        app:exitAnim="@anim/fade_out_nav"
        app:popEnterAnim="@anim/fade_in_nav"
        app:popExitAnim="@anim/fade_out_nav" />

</navigation>